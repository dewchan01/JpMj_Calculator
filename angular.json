{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "web": {
      "projectType": "application",
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json",
            "index": "apps/web/src/index.html",
            "outputPath": "dist/web",
            "styles": ["apps/web/src/styles.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public"
              },
              {
                "glob": "config.json",
                "input": "apps/web/config/production",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "pages": {
              "fileReplacements": [
                {
                  "replace": "apps/web/src/app/app-router.ts",
                  "with": "apps/web/src/app/app-router.pages.ts"
                }
              ]
            },
            "production": {
              "serviceWorker": "apps/web/ngsw-config.json",
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/web/public"
                },
                {
                  "glob": "config.json",
                  "input": "apps/web/config/development",
                  "output": "/"
                }
              ],
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "web:build:development"
            },
            "options": {
              "host": "0.0.0.0",
              "port": 4200,
              "allowedHosts": ["localhost"]
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
