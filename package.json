{
  "name": "riichi-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write apps packages e2e *.json *.ts *.js docs README.md",
    "format:check": "prettier --check apps packages e2e *.json *.ts *.js docs README.md",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "preview": "http-server dist/web/browser -p 4200 -c-1"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "dexie": "^4.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.0"
  }
}
