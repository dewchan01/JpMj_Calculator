{
  "name": "riichi-table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/check-doc-links.mjs",
    "i18n:generate": "node scripts/generate-zh-cn.mjs",
    "format": "prettier --write apps packages e2e scripts *.json *.ts *.js docs README.md",
    "format:check": "prettier --check apps packages e2e scripts *.json *.ts *.js docs README.md",
    "start": "ng serve",
    "start:host": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test",
    "preview": "http-server dist/web/browser -p 4200 -c-1",
    "prebuild": "node scripts/build-info.mjs",
    "postbuild": "node scripts/copy-licenses.mjs",
    "prestart": "node scripts/build-info.mjs",
    "prepare": "husky",
    "check:staged": "lint-staged",
    "check:push": "npm test && dotnet test apps/api.tests/Riichi.Api.Tests.csproj --configuration Release"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@microsoft/signalr": "^10.0.11",
    "dexie": "^4.2.0",
    "inferencejs": "^1.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.0"
  }
}
