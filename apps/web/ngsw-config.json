{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/*.html",
          "/*.css",
          "/*.js",
          "/*.webmanifest",
          "/*.svg",
          "/config.json",
          "/version.json",
          "/icons/**",
          "/sounds/**/*.mp3",
          "!/sounds/music/**",
          "/tiles/**/*.svg"
        ]
      }
    },
    {
      "name": "music",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": { "files": ["/sounds/music/*.mp3"] }
    }
  ]
}
