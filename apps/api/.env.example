# Deployment reference only. ASP.NET Core does NOT load this file automatically.
# Set these names in your hosting settings, or inject them from a secret manager.
# Keep actual passwords/keys outside Git; never copy them into this template.

# Published apps default to Production. Set explicitly if your host requires it.
ASPNETCORE_ENVIRONMENT=Production

# REQUIRED for production: full SQL Server connection string.
# MonsterASP: use the database user's LOCAL access connection string.
# Local Development can leave this empty to use SQLite.
ConnectionStrings__Database=

# OPTIONAL: override the frontend origin already set in appsettings.json.
# Origin only: no repository path, query string, or trailing slash.
# Cors__AllowedOrigins__0=https://your-frontend.example

# OPTIONAL: allow local Angular to call the HOSTED API.
# Not needed when local Angular calls the local Development API.
# Cors__AllowedOrigins__1=http://localhost:4200

# OPTIONAL: enable Seq. Blank ServerUrl keeps console-only logging.
# Use a separate Seq instance and supply its ingestion API key securely.
Seq__ServerUrl=
Seq__ApiKey=

# OPTIONAL overrides; appsettings.json already contains these defaults.
# Serilog__MinimumLevel__Default=Information
# Storage__MaxBytes=52428800
# Storage__MaxArchiveBytes=5242880
